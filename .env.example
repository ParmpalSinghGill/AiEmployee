# ════════════════════════════════════════════════════════════════════════════
#  AI Employee Framework — environment configuration
#  Copy to `.env` and fill in. Everything is overridable; the framework runs
#  fully offline with LLM_PROVIDER=mock and no external services.
# ════════════════════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME="AI Employee"
ENVIRONMENT=development            # development | staging | production
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false                    # true => JSON logs (for production aggregation)
API_HOST=0.0.0.0
API_PORT=8000

# ── LLM provider selection ───────────────────────────────────────────────────
# Swap the whole brain by changing this ONE value. No code changes required.
#   mock | deepseek | openai | gemini | glm | opencode | local
LLM_PROVIDER=deepseek

# Default model behaviour (provider-agnostic knobs)
LLM_TEMPERATURE=0.2
# Output ceiling per LLM call. On reasoning models (deepseek-reasoner) the
# chain-of-thought is billed against this same budget, so a low value gets
# answers cut off mid-sentence. 8192 leaves room for code + a real answer.
LLM_MAX_TOKENS=8192
LLM_REQUEST_TIMEOUT=60
# Transient errors (connection/timeout/5xx) use this many attempts.
LLM_MAX_RETRIES=3
# Rate limits (HTTP 429 / quota) get a longer, separate cooldown. The task shows
# "Cooling down" while the agent sleeps, then retries automatically. Retry-After
# from the provider is honored when present.
LLM_RATE_LIMIT_RETRIES=6
LLM_RATE_LIMIT_BASE_WAIT=5
LLM_RATE_LIMIT_MAX_WAIT=60

# ── DeepSeek (default) ───────────────────────────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_REASONING_MODEL=deepseek-reasoner
# DeepSeek has no embeddings endpoint; embeddings fall back to EMBEDDING_PROVIDER.

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_REASONING_MODEL=o3-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Google Gemini ────────────────────────────────────────────────────────────
GOOGLE_API_KEY=
# Chat: gemini-3.8-flash | gemini-3.6-flash | gemini-3.5-flash-lite |
#       gemini-3.1-flash-lite | gemini-2.5-pro | gemini-2.5-flash |
#       gemini-2.5-flash-lite | gemini-3.1-pro-preview | gemini-3-flash-preview |
#       gemini-pro-latest | gemini-flash-latest
GEMINI_CHAT_MODEL=gemini-2.5-pro
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ── GLM / Zhipu (OpenAI-compatible) ──────────────────────────────────────────
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_CHAT_MODEL=glm-4-plus
GLM_EMBEDDING_MODEL=embedding-3

# ── OpenCode Zen (OpenAI-compatible gateway) ─────────────────────────────────
# One key reaches many hosted models (Claude, GPT, DeepSeek, GLM, Gemini, …).
# Create/manage the key from your workspace at opencode.ai/workspace/wrk_… and
# set LLM_PROVIDER=opencode. No embeddings endpoint (use EMBEDDING_PROVIDER).
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_CHAT_MODEL=deepseek-v4-pro        # e.g. claude-opus-4-8, gpt-5.5, glm-5.2
OPENCODE_REASONING_MODEL=                  # blank → reuse chat model for reasoning
OPENCODE_WORKSPACE=                         # informational: your wrk_… id

# ── Local models (Ollama / vLLM / LM Studio / llama.cpp) ─────────────────────
# Set LLM_PROVIDER=local to run fully on your machine. Defaults target Ollama
# with Qwen3 8B. Start Ollama and `ollama pull qwen3:8b` first.
LOCAL_BASE_URL=http://localhost:11434/v1   # Ollama. vLLM: http://localhost:8000/v1
LOCAL_API_KEY=ollama                       # ignored by most local servers
LOCAL_CHAT_MODEL=qwen3:8b
LOCAL_REASONING_MODEL=qwen3:8b             # Qwen3 has a built-in thinking mode
LOCAL_EMBEDDING_MODEL=dengcao/Qwen3-Embedding-8B:Q4_K_M
LOCAL_STRIP_THINK=true                     # hide <think>…</think> from answers
LOCAL_THINKING=false                       # false = much faster multi-step runs (sends /no_think)
# When using local embeddings, set EMBEDDING_DIM to match the model:
#   Qwen3-Embedding-8B = 4096, nomic-embed-text = 768, mxbai-embed-large = 1024
# and set EMBEDDING_PROVIDER=local below.

# ── Embeddings ───────────────────────────────────────────────────────────────
# Used by RAG / long-term memory. If the chat provider lacks embeddings
# (e.g. DeepSeek), this provider is used instead.
EMBEDDING_PROVIDER=openai          # openai | gemini | glm | mock
EMBEDDING_DIM=1536                 # must match the chosen embedding model

# ── PostgreSQL + pgvector ────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ai_employee
POSTGRES_PASSWORD=ai_employee
POSTGRES_DB=ai_employee
# Full async URL is derived from the parts above; override only if needed.
# DATABASE_URL=postgresql+asyncpg://ai_employee:ai_employee@localhost:5432/ai_employee

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Tools / integrations (all optional) ──────────────────────────────────────
GITHUB_TOKEN=
TAVILY_API_KEY=                    # web search (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── Agent loop / loop check ──────────────────────────────────────────────────
# Each agent runs a fixed base number of tool rounds (per-agent "max_iterations"
# in src/ai_employee/agents/specs.py). When an agent hits that cap WITHOUT an
# answer, a loop check inspects the recent transcript:
#   * stuck (repeating calls / no progress) → stop;
#   * still making progress → grant another window (bounded, below).
# AGENT_LOOP_CHECK_ENABLED=true
# Extra windows granted when the loop check says "no loop".
# AGENT_LOOP_EXTENSIONS_MAX=2
# ── Per-agent iteration & loop budgets ───────────────────────────────────────
# Base tool rounds an agent gets before its loop check runs. 0 => each agent's
# built-in default (7–12, set in src/ai_employee/agents/specs.py).
# AGENT_MAX_ITERATIONS=0
# Per-agent base-round overrides (name=value, comma-separated). These WIN over
# AGENT_MAX_ITERATIONS and the built-in default.
#   AGENT_MAX_ITERATIONS_BY_NAME=coding=24,research=16,planner=4
# AGENT_MAX_ITERATIONS_BY_NAME=
# Per-agent loop overrides: how many extra windows the loop check may grant when
# it judges the agent "progressing" (falls back to AGENT_LOOP_EXTENSIONS_MAX).
# Total rounds = iterations × (1 + loops).
#   AGENT_LOOP_EXTENSIONS_BY_NAME=coding=4,research=2
# AGENT_LOOP_EXTENSIONS_BY_NAME=
# Transcript entries inspected (0 => the agent's own max_iterations).
# AGENT_LOOP_CHECK_WINDOW=0
# Let an ambiguous verdict escalate to a cheap LLM judge (auto-skipped for mock).
# AGENT_LOOP_CHECK_LLM=true
# A call (or a repeated read of the same target) repeating this many times in
# the window counts as a definite loop signal (4 => must exceed 3 repeats).
# AGENT_LOOP_REPEAT_THRESHOLD=4
# A short A,B(,C) cycle must repeat at least this many times to count as a loop
# (normal edit->test->edit->test repeats twice; it must not be flagged).
# AGENT_LOOP_CYCLE_MIN_REPEATS=4
# Abort an agent after a tool fails this many times with the SAME error class.
# AGENT_REPEAT_FAILURE_LIMIT=2

# ── Explain view: input/output text kept ─────────────────────────────────────
# The Explain tab shows the exact input/output of every LLM call, tool, planner
# and verifier. These cap how many characters of each string are stored; the
# dashboard's "Expand all" button reveals everything that was stored.
# 0 = keep EVERYTHING (no truncation) — the default. Set a positive number to
# cap very large outputs (smaller = lighter events).
# EXPLAIN_MAX_CHARS=0            # LLM messages, step task/system prompt, answers
# EXPLAIN_TOOL_MAX_CHARS=0       # tool arguments and tool output

# ── Coding agent backend ─────────────────────────────────────────────────────
# Which engine writes & runs code when the planner routes to the coding agent.
#   brain  → use the configured LLM via the normal tool loop (default)
#   claude → Claude Code CLI; codex → Codex CLI; cursor → Cursor Agent CLI
# CODING_BACKEND=brain
# CLAUDE_CLI_CMD=claude
# CLAUDE_CLI_ARGS=-p --permission-mode acceptEdits
# CODEX_CLI_CMD=codex
# CODEX_CLI_ARGS=exec --full-auto
# CURSOR_CLI_CMD=cursor-agent
# CURSOR_CLI_ARGS=-p --force
# EXTERNAL_AGENT_TIMEOUT=600

# ── Safety / autonomy ────────────────────────────────────────────────────────
# Operations matching these require human approval before execution.
REQUIRE_APPROVAL_FOR=shell_write,email_send,git_push,db_write,deploy
# Hard sandbox switch for code/shell execution tools.
ENABLE_CODE_EXECUTION=true
WORKSPACE_DIR=./data/workspace

# ── YouTube downloads (yt-dlp) ───────────────────────────────────────────────
# Age-restricted videos need cookies from a LOGGED-IN YouTube session.
# Option A — live browser (recommended on Linux: pip install secretstorage):
# YTDLP_COOKIES_FROM_BROWSER=chrome
# Option B — exported Netscape cookies.txt (must include LOGIN_INFO or SID+SAPISID):
# YTDLP_COOKIES_FILE=./www.youtube.com_cookies.txt
# Export while signed into YouTube; open the age-restricted video in the browser first.

# Hugging Face model/dataset downloads (huggingface_hub — automatic via download_resource).
# Public repos need no token; gated/private repos need HF_TOKEN from huggingface.co/settings/tokens
# HF_TOKEN=hf_...
